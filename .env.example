# Dijital Öğretmen Asistanı (DÖA) — Environment Variables
# Bu dosyayı kopyalayıp .env olarak kaydedin ve gerçek değerleri girin.
# ASLA .env dosyasını commit etmeyin (zaten .gitignore'da).
#
# ADR: PII asla buluta gitmez. Cloud Brain yalnızca anonim içerik alır.
# Dosya depolama yalnızca yerel SQLite/SQLCipher üzerindedir.

# Database (yerel SQLite — Phase 4'te SQLCipher AES-256)
DATABASE_URL=sqlite+aiosqlite:///./doa_local.db

# DeepSeek API (Phase 3+ için gerekli, Phase 1-2'de opsiyonel)
DEEPSEEK_API_KEY=***

# JWT Secret (üretimde güçlü bir random string kullanın)
SECRET_KEY=change-me-in-production

# CORS — frontend origin'leri
CORS_ORIGINS=http://localhost:5173

# Debug modu
DEBUG=false
