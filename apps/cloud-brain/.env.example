# Teachmate Cloud Brain — ortam değişkenleri

# ── Yazılı Okuma (sınav kağıdı görsel OCR) ──
# DeepSeek-OCR 2 — görsel/OCR için BİRİNCİL motor (düşük maliyetli, görsel OCR için tercih)
DEEPSEEK_OCR_API_KEY=
DEEPSEEK_OCR_MODEL=deepseek-ocr-2
DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepSeek V4 — metin değerlendirme (OCR anahtarı boşsa bu da kullanılır)
DEEPSEEK_API_KEY=

# ── Görsel yedek (opsiyonel) ──
# Gemini Vision — DeepSeek-OCR yoksa görsel yedeği
GEMINI_API_KEY=

# ── Genel ──
AI_PROVIDER=auto          # auto | mock | none
MAARIF_DB_PATH=maarif_os.db
